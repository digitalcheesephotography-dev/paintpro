rules_version = '2';

// PaintPro Firestore security rules.
//
// These are the ACTUAL rules that must be published in the Firebase console
// (Firestore Database -> Rules -> paste -> Publish). Keeping them here in the
// repo makes them reviewable and version-controlled instead of living only in
// the console where nobody can verify them.
//
// Tenant isolation: every user's data lives under users/{uid}/data/{document},
// and a user may only read or write documents under their OWN uid. There is no
// path that lets one signed-in account reach another account's data. The app
// reads/writes exactly this path (see _userDoc() in PaintPro-ZFold.html).
//
// VERIFY AFTER PUBLISHING: sign in as user A, then attempt to read
// users/<user-B-uid>/data/<key> — it must be denied. Anything created in
// "test mode" (allow read, write: if true) exposes every tenant to each other,
// so confirm this file is what is actually deployed.

service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own data — the only collection the app uses.
    match /users/{uid}/data/{document} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Client e-signature proposals. The document ID is a 128-bit random value
    // that acts as a capability (the shareable link) — like a DocuSign link.
    // - Anyone with the link can READ it (the homeowner has no account).
    // - Only the signed-in owner can CREATE or DELETE their own proposals.
    // - A client (unauthenticated) may accept exactly ONCE: the update is
    //   allowed only while status is 'sent', flips it to 'accepted', supplies a
    //   non-empty signer name, and cannot change the owner or the bid body.
    match /proposals/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'sent';
      allow update: if resource.data.status == 'sent'
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.bodyHtml == resource.data.bodyHtml
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.signerName is string
                    && request.resource.data.signerName.size() > 0;
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Everything else is denied by default (no other rules = no access).
  }
}
