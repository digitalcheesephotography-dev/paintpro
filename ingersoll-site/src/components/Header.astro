---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Our Work', href: '/our-work' },
  { label: 'About', href: '/about' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img
          src="/logo.jpg"
          alt="Ingersoll Painting LLC"
          class="h-10 lg:h-12 w-auto object-contain"
          width="160"
          height="48"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='block'"
        />
        <span
          class="hidden text-[#2baae1] font-heading text-2xl leading-none"
          style="font-family: 'Bebas Neue', sans-serif; display: none;"
        >
          Ingersoll Painting
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-3 py-2 text-sm font-medium rounded transition-colors ${
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-[#2baae1] border-b-2 border-[#2baae1]'
                : 'text-gray-700 hover:text-[#2baae1]'
            }`}
            style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem; letter-spacing: 0.05em;"
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right: Phone + CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="tel:+13159528259"
          class="text-gray-700 hover:text-[#2baae1] font-medium text-sm transition-colors"
          style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
        >
          (315) 952-8259
        </a>
        <a
          href="/contact"
          class="bg-[#2baae1] hover:bg-[#1e8fc4] text-white font-medium px-5 py-2.5 rounded transition-colors whitespace-nowrap"
          style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem; letter-spacing: 0.05em;"
        >
          Get Free Estimate
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded text-gray-700 hover:text-[#2baae1] hover:bg-gray-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-gray-200 bg-white"
  >
    <nav class="px-4 py-3 space-y-1" aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`block px-3 py-3 rounded font-medium text-base transition-colors min-h-[44px] flex items-center ${
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'text-[#2baae1] bg-blue-50'
              : 'text-gray-700 hover:text-[#2baae1] hover:bg-gray-50'
          }`}
          style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.15rem;"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 pb-1 border-t border-gray-100 space-y-2">
        <a
          href="tel:+13159528259"
          class="flex items-center gap-2 px-3 py-3 text-gray-700 hover:text-[#2baae1] font-medium"
          style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.1rem;"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          (315) 952-8259
        </a>
        <a
          href="/contact"
          class="block mx-3 text-center bg-[#2baae1] hover:bg-[#1e8fc4] text-white font-medium px-5 py-3 rounded transition-colors"
          style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.1rem;"
        >
          Get Free Estimate
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconMenu?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
