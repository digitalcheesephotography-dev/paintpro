---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  'Interior Painting',
  'Exterior Painting',
  'Cabinet Refinishing',
  'Deck Building, Staining & Pressure Washing',
  'Drywall Installation & Repair',
  'Epoxy Floor Coatings',
  'Basement Remodeling',
  'Bathroom Remodeling',
  'Commercial Painting & Renovation',
  'Not sure yet / Multiple services',
];

// TODO: Replace with your Web3Forms access key from https://web3forms.com
const WEB3FORMS_KEY = 'YOUR_ACCESS_KEY_HERE';
---

<BaseLayout
  title="Contact & Free Estimate | Ingersoll Painting LLC"
  description="Request a free estimate from Ingersoll Painting LLC. Serving Oswego, Onondaga, and Cayuga counties. Call (315) 952-8259 or fill out the form and we'll get back to you within one business day."
>

  <!-- Hero -->
  <section class="bg-gray-900 py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p
        class="text-[#2baae1] uppercase tracking-widest text-sm mb-3"
        style="font-family: 'Barlow Condensed', sans-serif; letter-spacing: 0.15em;"
      >
        Get in Touch
      </p>
      <h1
        class="text-white text-6xl sm:text-7xl lg:text-8xl leading-none mb-5"
        style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.04em;"
      >
        Free Estimate
      </h1>
      <p
        class="text-gray-400 text-xl max-w-xl mx-auto"
        style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.15rem;"
      >
        Fill out the form or call us directly. We respond within one business day.
      </p>
    </div>
  </section>

  <!-- Two-column layout -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">

      <!-- ===== Left: Contact Form ===== -->
      <div class="lg:col-span-3">
        <h2
          class="text-3xl text-gray-900 mb-6"
          style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.06em;"
        >
          Tell Us About Your Project
        </h2>

        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
          novalidate
        >
          <!-- Web3Forms access key -->
          <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
          <input type="hidden" name="subject" value="New estimate request — Ingersoll Painting LLC" />
          <input type="hidden" name="from_name" value="Ingersoll Painting Website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

          <!-- Name + Phone row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-gray-700 mb-1.5"
                style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
              >
                Your Name <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="James Smith"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#2baae1] focus:ring-2 focus:ring-[#2baae1]/20 transition-colors min-h-[54px]"
                style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
              />
            </div>
            <div>
              <label
                for="phone"
                class="block text-sm font-medium text-gray-700 mb-1.5"
                style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
              >
                Phone Number <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                placeholder="(315) 555-1234"
                class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#2baae1] focus:ring-2 focus:ring-[#2baae1]/20 transition-colors min-h-[54px]"
                style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
              />
            </div>
          </div>

          <!-- Email -->
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-gray-700 mb-1.5"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
            >
              Email Address <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#2baae1] focus:ring-2 focus:ring-[#2baae1]/20 transition-colors min-h-[54px]"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
            />
          </div>

          <!-- Address -->
          <div>
            <label
              for="address"
              class="block text-sm font-medium text-gray-700 mb-1.5"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
            >
              Property Address <span class="text-gray-400 font-normal">(optional)</span>
            </label>
            <input
              type="text"
              id="address"
              name="address"
              autocomplete="street-address"
              placeholder="123 Main St, Oswego, NY"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#2baae1] focus:ring-2 focus:ring-[#2baae1]/20 transition-colors min-h-[54px]"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
            />
          </div>

          <!-- Service dropdown -->
          <div>
            <label
              for="service"
              class="block text-sm font-medium text-gray-700 mb-1.5"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
            >
              Service Needed <span class="text-red-500" aria-hidden="true">*</span>
            </label>
            <select
              id="service"
              name="service"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:outline-none focus:border-[#2baae1] focus:ring-2 focus:ring-[#2baae1]/20 transition-colors min-h-[54px] bg-white"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
            >
              <option value="" disabled selected>Select a service...</option>
              {services.map(s => (
                <option value={s}>{s}</option>
              ))}
            </select>
          </div>

          <!-- Project details -->
          <div>
            <label
              for="message"
              class="block text-sm font-medium text-gray-700 mb-1.5"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
            >
              Project Details
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Tell us about the project — size, current condition, timeline, any questions..."
              class="w-full border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:border-[#2baae1] focus:ring-2 focus:ring-[#2baae1]/20 transition-colors resize-y"
              style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full bg-[#2baae1] hover:bg-[#1e8fc4] text-white font-semibold px-8 py-4 rounded-lg transition-colors text-lg min-h-[54px] flex items-center justify-center gap-2"
            style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.2rem; letter-spacing: 0.05em;"
          >
            <span id="btn-text">Send Estimate Request</span>
            <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </button>

          <!-- Success / error messages -->
          <div
            id="form-success"
            class="hidden bg-green-50 border border-green-200 text-green-800 rounded-lg px-5 py-4 text-base"
            role="alert"
            style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
          >
            Message sent! We'll get back to you within one business day. You can also call us at (315) 952-8259.
          </div>
          <div
            id="form-error"
            class="hidden bg-red-50 border border-red-200 text-red-800 rounded-lg px-5 py-4 text-base"
            role="alert"
            style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
          >
            Something went wrong. Please try again or call us directly at <a href="tel:+13159528259" class="underline font-medium">(315) 952-8259</a>.
          </div>
        </form>
      </div>

      <!-- ===== Right: Contact Info ===== -->
      <div class="lg:col-span-2 space-y-8">
        <div>
          <h2
            class="text-3xl text-gray-900 mb-5"
            style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.06em;"
          >
            Contact Info
          </h2>
          <ul class="space-y-5">
            <li>
              <a
                href="tel:+13159528259"
                class="flex items-start gap-4 group"
              >
                <div class="w-11 h-11 rounded-xl bg-[#2baae1]/10 flex items-center justify-center shrink-0 group-hover:bg-[#2baae1] transition-colors">
                  <svg class="w-5 h-5 text-[#2baae1] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5" style="font-family:'Barlow Condensed',sans-serif;">Phone</p>
                  <p class="text-gray-900 text-xl font-medium group-hover:text-[#2baae1] transition-colors" style="font-family:'Barlow Condensed',sans-serif;font-size:1.3rem;">(315) 952-8259</p>
                </div>
              </a>
            </li>
            <li>
              <a
                href="mailto:info@ingersollpaintingllc.com"
                class="flex items-start gap-4 group"
              >
                <div class="w-11 h-11 rounded-xl bg-[#2baae1]/10 flex items-center justify-center shrink-0 group-hover:bg-[#2baae1] transition-colors">
                  <svg class="w-5 h-5 text-[#2baae1] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5" style="font-family:'Barlow Condensed',sans-serif;">Email</p>
                  <p class="text-gray-900 text-lg group-hover:text-[#2baae1] transition-colors break-all" style="font-family:'Barlow Condensed',sans-serif;font-size:1.1rem;">info@ingersollpaintingllc.com</p>
                </div>
              </a>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-[#2baae1]/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#2baae1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5" style="font-family:'Barlow Condensed',sans-serif;">Address</p>
                <p class="text-gray-900" style="font-family:'Barlow Condensed',sans-serif;font-size:1.1rem;">496 Phinney Road<br />Hannibal, NY 13074</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="w-11 h-11 rounded-xl bg-[#2baae1]/10 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-[#2baae1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5" style="font-family:'Barlow Condensed',sans-serif;">Hours</p>
                <p class="text-gray-900" style="font-family:'Barlow Condensed',sans-serif;font-size:1.1rem;">
                  Mon - Thu: 8:00am - 5:00pm<br />
                  Fri: 8:00am - 4:00pm<br />
                  <span class="text-gray-400 text-sm">Sat - Sun: Closed</span>
                </p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Social links -->
        <div>
          <p
            class="text-xs text-gray-400 uppercase tracking-wider mb-3"
            style="font-family: 'Barlow Condensed', sans-serif; letter-spacing: 0.15em;"
          >
            Follow Us
          </p>
          <div class="flex gap-3">
            <a
              href="https://www.facebook.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="w-11 h-11 rounded-xl bg-gray-100 hover:bg-[#2baae1] flex items-center justify-center text-gray-500 hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
              </svg>
            </a>
            <a
              href="https://www.instagram.com/ingersollpainting"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="w-11 h-11 rounded-xl bg-gray-100 hover:bg-[#2baae1] flex items-center justify-center text-gray-500 hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"/>
                <circle cx="12" cy="12" r="4" stroke-width="2"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
            </a>
            <a
              href="https://www.tiktok.com/@ingersollpainting"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
              class="w-11 h-11 rounded-xl bg-gray-100 hover:bg-[#2baae1] flex items-center justify-center text-gray-500 hover:text-white transition-colors"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Google Map embed -->
        <div class="rounded-2xl overflow-hidden shadow-sm border border-gray-200">
          <iframe
            title="Ingersoll Painting LLC location map"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2895.432!2d-76.3896!3d43.3168!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNDPCsDE5JzAwLjUiTiA3NsKwMjMnMjIuNiJX!5e0!3m2!1sen!2sus!4v1234567890"
            width="100%"
            height="240"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Show spinner
    if (btnText) btnText.textContent = 'Sending...';
    btnSpinner?.classList.remove('hidden');
    if (submitBtn) submitBtn.disabled = true;
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      const data = new FormData(form);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: data,
      });
      const json = await res.json();

      if (json.success) {
        form.reset();
        successMsg?.classList.remove('hidden');
        successMsg?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        throw new Error(json.message ?? 'Submission failed');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
      errorMsg?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } finally {
      if (btnText) btnText.textContent = 'Send Estimate Request';
      btnSpinner?.classList.add('hidden');
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
