---
interface Props {
  heading?: string;
  subtext?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading = 'Ready to Transform Your Space?',
  subtext = 'Get a free, no-obligation estimate from Central New York\'s most trusted painting and renovation team.',
  primaryLabel = 'Get Free Estimate',
  primaryHref = '/contact',
  secondaryLabel = 'Call (315) 952-8259',
  secondaryHref = 'tel:+13159528259',
} = Astro.props;
---

<section class="bg-[#2baae1] py-16 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h2
      class="text-white text-4xl sm:text-5xl lg:text-6xl mb-4"
      style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.06em;"
    >
      {heading}
    </h2>
    <p
      class="text-white/90 text-lg sm:text-xl mb-8 max-w-2xl mx-auto"
      style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.2rem;"
    >
      {subtext}
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={primaryHref}
        class="inline-block bg-white text-[#2baae1] font-semibold px-8 py-4 rounded-lg hover:bg-gray-100 transition-colors text-lg min-h-[54px] flex items-center justify-center"
        style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.15rem; letter-spacing: 0.05em;"
      >
        {primaryLabel}
      </a>
      <a
        href={secondaryHref}
        class="inline-block bg-transparent border-2 border-white text-white font-semibold px-8 py-4 rounded-lg hover:bg-white hover:text-[#2baae1] transition-colors text-lg min-h-[54px] flex items-center justify-center"
        style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.15rem; letter-spacing: 0.05em;"
      >
        {secondaryLabel}
      </a>
    </div>
  </div>
</section>
