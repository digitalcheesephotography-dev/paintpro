---
const services = [
  { label: 'Interior Painting', href: '/services#interior' },
  { label: 'Exterior Painting', href: '/services#exterior' },
  { label: 'Deck Building & Staining', href: '/services#decks' },
  { label: 'Cabinet Refinishing', href: '/services#cabinets' },
  { label: 'Drywall Repair', href: '/services#drywall' },
  { label: 'Epoxy Floor Coatings', href: '/services#epoxy' },
  { label: 'Basement Remodeling', href: '/services#basement' },
  { label: 'Bathroom Remodeling', href: '/services#bathroom' },
  { label: 'Commercial Painting', href: '/services#commercial' },
];

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Our Work', href: '/our-work' },
  { label: 'About Us', href: '/about' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <img
          src="/logo.png"
          alt="Ingersoll Painting LLC"
          class="h-14 w-auto object-contain mb-4 brightness-150"
          width="160"
          height="56"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='block'"
        />
        <p
          class="text-[#2baae1] text-2xl mb-4 hidden"
          style="font-family: 'Bebas Neue', sans-serif; display: none;"
        >
          Ingersoll Painting LLC
        </p>
        <p class="text-sm text-gray-400 leading-relaxed mb-4" style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;">
          Family-owned painting and renovation contractor serving Central New York since 1978. Quality work, honest pricing, guaranteed.
        </p>
        <div class="flex gap-4 mt-2">
          <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-gray-400 hover:text-[#2baae1] transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
            </svg>
          </a>
          <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-gray-400 hover:text-[#2baae1] transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"/>
              <circle cx="12" cy="12" r="4" stroke-width="2"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-gray-400 hover:text-[#2baae1] transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services column -->
      <div>
        <h3 class="text-white text-xl mb-4" style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.08em;">Services</h3>
        <ul class="space-y-2">
          {services.map(s => (
            <li>
              <a
                href={s.href}
                class="text-gray-400 hover:text-[#2baae1] transition-colors text-sm"
                style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick links column -->
      <div>
        <h3 class="text-white text-xl mb-4" style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.08em;">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map(l => (
            <li>
              <a
                href={l.href}
                class="text-gray-400 hover:text-[#2baae1] transition-colors"
                style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div>
        <h3 class="text-white text-xl mb-4" style="font-family: 'Bebas Neue', sans-serif; letter-spacing: 0.08em;">Contact Us</h3>
        <ul class="space-y-3 text-gray-400" style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem;">
          <li class="flex gap-2">
            <svg class="w-5 h-5 shrink-0 text-[#2baae1] mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>496 Phinney Road<br />Hannibal, NY 13074</span>
          </li>
          <li class="flex gap-2">
            <svg class="w-5 h-5 shrink-0 text-[#2baae1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+13159528259" class="hover:text-[#2baae1] transition-colors">(315) 952-8259</a>
          </li>
          <li class="flex gap-2">
            <svg class="w-5 h-5 shrink-0 text-[#2baae1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@ingersollpaintingllc.com" class="hover:text-[#2baae1] transition-colors">info@ingersollpaintingllc.com</a>
          </li>
          <li class="flex gap-2">
            <svg class="w-5 h-5 shrink-0 text-[#2baae1]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Mon-Thu: 8am-5pm<br />Fri: 8am-4pm</span>
          </li>
        </ul>
        <div class="mt-5">
          <a
            href="/contact"
            class="inline-block bg-[#2baae1] hover:bg-[#1e8fc4] text-white font-medium px-5 py-2.5 rounded transition-colors"
            style="font-family: 'Barlow Condensed', sans-serif; font-size: 1.05rem;"
          >
            Get Free Estimate
          </a>
        </div>
      </div>
    </div>

    <!-- Service area note -->
    <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-sm text-gray-500">
      <p style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.95rem;">
        Proudly serving Oswego, Onondaga &amp; Cayuga counties, NY
      </p>
      <p style="font-family: 'Barlow Condensed', sans-serif; font-size: 0.95rem;">
        &copy; {new Date().getFullYear()} Ingersoll Painting LLC. All rights reserved.
      </p>
    </div>
  </div>
</footer>
